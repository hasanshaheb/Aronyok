# ==============================================================================
# ARONYOK (আরণ্যক) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase (Project URL & Anon Key for Client; Service Key for Server Route handlers)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-operations

# OpenRouter AI (Free models: meta-llama/llama-3.3-70b-instruct:free, meta-llama/llama-3-8b-instruct:free)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Site Domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment Gateways (Scaffolding for Checkout)
# Stripe
STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# bKash / Nagad MFS (Bangladesh)
BKASH_APP_KEY=bkash_app_key_placeholder
BKASH_APP_SECRET=bkash_secret_placeholder
BKASH_USERNAME=bkash_username_placeholder
BKASH_PASSWORD=bkash_password_placeholder
